# Private full-text Parquet corpus (the complete configured archive, not the
# old 2015-2020 paragraph-extraction subset).
GOAI_LOCAL_CORPUS_ROOTS=/path/to/markdown-v1-final
# The private DOI fast path is a pair; configuring only one is an error.
# GOAI_LOCAL_CORPUS_EXPECTED_INDEX=/path/to/markdown_expected.sqlite
# GOAI_LOCAL_CORPUS_SHARD_ROOT=/path/to/markdown-v1/shards

# Public/submission mode uses the same variable and MCP API. Point it at an
# exported compact package, or try the repository's non-citable synthetic demo:
# GOAI_LOCAL_CORPUS_ROOTS=/absolute/path/to/goai_research/examples/demo_corpus
GOAI_LOCAL_CORPUS_TIMEOUT=30

# Vendored two-stage inorganic retrosynthesis model.
GOAI_RETRO_DEVICE=cpu
# GOAI_INORGANIC_RETRO_ROOT=/alternate/path/to/two_stage_retro

# All deterministic tool requests/results are appended here by default:
# $GOAI_WORKSPACE/state/tool_calls.jsonl
# GOAI_TOOL_AUDIT_LOG=/absolute/path/to/tool_calls.jsonl
GOAI_RUN_ID=example-run-id
