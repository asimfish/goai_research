__pycache__/
*.pyc
.venv/
.venv-retro/
.pytest_cache/
*.egg-info/
.DS_Store

# LaTeX 编译中间产物（pdf 保留，可直接看成品）
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.xdv
*.toc
examples/**/paper/main.log
examples/**/paper/main.out

# 运行时工作区产物（递归忽略；只保留目录骨架）
workspace/**
!workspace/**/
!workspace/**/.gitkeep

# 实测（live tests）运行产物：报告入库在 docs/live-tests/，产物本身不入库
workspace_live/
# scripts/reproduce_core.sh 与 scripts/run_three_synthesis_topics.sh 的本地运行工作区
workspace_repro_*/
workspace_runs/

# install.sh 生成的本机路径版配置（example 版入库）
configs/codex.config.toml
configs/claude.mcp.json

# 本地缓存
.cache/
*.jsonl.lock

# submission archives built by scripts/package_submission.sh
dist/
# 控制台前端（Vite）构建产物随仓库提交，python3 tools/console_server.py 直接托管，不需要 node
!tools/console/dist/
tools/console/node_modules/
