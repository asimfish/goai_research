__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
.DS_Store

# 运行时工作区产物（保留目录结构，不提交内容）
workspace/library/pdfs/*.pdf
workspace/library/*.jsonl
workspace/library/*.bib
workspace/notes/*.md
workspace/figures/svg/*.svg
workspace/figures/drawio/*.drawio
workspace/figures/png/*.png
workspace/figures/figspec/*.json
workspace/ideas/**
workspace/drafts/**
workspace/state/*.json
workspace/state/round_*/
!workspace/**/.gitkeep

# 实测（live tests）运行产物：报告入库在 docs/live-tests/，产物本身不入库
workspace_live/

# install.sh 生成的本机路径版配置（example 版入库）
configs/codex.config.toml
configs/claude.mcp.json

# 本地缓存
.cache/
