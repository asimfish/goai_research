        0.0
      ]
    }
  ],
  "tasks": [
    {
      "id": "t_recover",
      "type": "RecoverPowder",
      "station": "grinder_1",
      "samples": [
        "s1"
      ],
      "depends_on": [],
      "params": {
        "grind_seconds": 120
      },
      "primitives": [
        {
          "op": "weigh",
          "object": "crucible_s1",
          "station": "balance_1"
        },
        {
          "op": "pour_powder",
          "object": "crucible_s1",
          "to": "grinder_1"
        },
        {
          "op": "pick_place",
          "object": "pestle_1",
          "to": "grinder_1"
        },
        {
          "op": "stir",
          "tool": "pestle_1",
          "station": "grinder_1",
          "seconds": 120
        },
        {
          "op": "pick_place",
          "object": "pestle_1",
          "to": "rack_1"
        },
        {
          "op": "uncap",
          "object": "vial_s1"
        },
        {
          "op": "pick_place",
          "object": "funnel_1",
          "to": "vial_s1"
        },
        {
          "op": "pour_powder",
          "object": "grinder_1",
          "to": "funnel_1"
        },
        {
          "op": "pick_place",
          "object": "funnel_1",
          "to": "prep_1"
        },
        {
          "op": "cap",
          "object": "vial_s1"
        },
        {
          "op": "weigh",
          "object": "vial_s1",
          "station": "balance_1"
        },
        {
          "op": "pick_place",
          "object": "crucible_s1",
          "to": "waste_1"
        }
      ],
      "on_error": {
        "retry": 3,
        "then": "request_user_input"
      },
      "instruction": "Weigh the crucible, grind its contents in the mortar for 2 minutes, funnel the powder into the vial, cap and weigh the vial, discard the crucible."
    },
    {
      "id": "t_prep",
      "type": "PrepareSampleforXRD",
      "station": "prep_1",
      "samples": [
        "s1"
      ],
      "depends_on": [
        "t_recover"
      ],
      "params": {
        "target_mass_mg": 100,
        "max_attempts": 3
      },
      "primitives": [
        {
          "op": "pick_place",
          "object": "holder_1",
          "to": "prep_1"
        },
        {
          "op": "uncap",
          "object": "vial_s1"
        },
        {
          "op": "pour_powder",
          "object": "vial_s1",
          "to": "holder_1"
        },
        {
          "op": "flatten",
          "object": "holder_1",
          "tool": "disc_1"
        },
        {
          "op": "weigh",
          "object": "holder_1",
          "station": "balance_1"
        },
        {
          "op": "cap",
          "object": "vial_s1"
        },
        {
          "op": "pick_place",
          "object": "vial_s1",
          "to": "rack_1"
        }
      ],
      "on_error": {
        "retry": 3,
        "then": "request_user_input"
      },
      "instruction": "Pour about 100 mg of powder onto the holder, flatten it with the disc, weigh, re-cap the vial."
    },
    {
      "id": "t_xrd",
      "type": "Diffraction",
      "station": "xrd_1",
      "samples": [
        "s1"
      ],
      "depends_on": [
        "t_prep"
      ],
      "params": {
        "two_theta_range": [
          10,
          100
        ],
        "scan_min": 8
      },
      "primitives": [
        {
          "op": "open_door",
          "station": "xrd_1"
        },
        {
          "op": "pick_place",
          "object": "holder_1",
          "to": "xrd_1"
        },
        {
          "op": "close_door",
          "station": "xrd_1"
        },
        {
          "op": "press_button",
          "station": "xrd_1",
          "button": "start"
        },
        {
          "op": "wait",
          "seconds": 30
        },
        {
          "op": "open_door",
          "station": "xrd_1"
        },
        {
          "op": "pick_place",
          "object": "holder_1",
          "to": "rack_1"
        },
        {
          "op": "close_door",
          "station": "xrd_1"
        }
      ],
      "on_error": {
        "retry": 3,
        "then": "request_user_input"
      },
      "instruction": "Load the holder into the diffractometer, run the 10-100 degree scan, unload the holder."
    },
    {
      "id": "t_end",
      "type": "Ending",
      "station": "rack_1",
      "samples": [
        "s1"
      ],
      "depends_on": [
        "t_xrd"
      ],
      "params": {},
      "primitives": [
        {
          "op": "pick_place",
          "object": "holder_1",
          "to": "rack_1"
        }
      ],
      "on_error": {
        "retry": 3,
        "then": "request_user_input"
      }
    }
  ],
  "safety_constraints": {
    "dp_max_mm": 20,
    "theta_dev_max_rad": 0.25,
    "f_peak_max_n": 20,
    "tilt_limit_rad": 0.85
  },
  "evidence": [
    {
      "claim": "After heating, the A-Lab grinds each crucible with a 10 mm alumina ball in a vertical shaker, pours the powder through a steel mesh onto an XRD holder, flattens it with an acrylic disc and scans 10-100 degrees for 8 minutes.",
      "cite": "szymanski2023alab"
    },
    {
      "claim": "BaZn2Si2O7 has a reversible phase transition and known crystal structures usable as XRD reference phases.",
      "cite": "lin1999phase"
    },
    {
      "claim": "Automated phase identification and Rietveld refinement close the loop on XRD data in the A-Lab.",
      "cite": "szymanski2023alab"
    }
  ]
}
