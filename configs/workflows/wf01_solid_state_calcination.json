  },
  "evidence": [
    {
      "claim": "The A-Lab heats crucibles in box furnaces at 2 C/min to 300 C, then 15 C/min to the target, with a 4 h dwell and passive cooling to 100 C before robotic unloading.",
      "cite": "szymanski2023alab"
    },
    {
      "claim": "BaZn2Si2O7 is prepared by solid-state reaction of BaCO3, ZnO and SiO2 and studied as an SOFC sealant.",
      "cite": "kerstan2013bazn2si2o7"
    },
    {
      "claim": "BaZn2Si2O7-based solid solutions and their polymorphism have been reviewed; the low-temperature/high-temperature transition motivates controlled calcination.",
      "cite": "thieme2022solid"
    },
    {
      "claim": "Transport tilt limit 0.25 rad and 20 mm spatial tolerance are SafeLab's calibrated safety thresholds.",
      "cite": "bai2026safelab"
    }
  ]
