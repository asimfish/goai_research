# 私有全库语料（NAS Parquet）——复制为仓库外文件（如 ~/goai_console.env），传给
#   python3 tools/console_server.py --private-corpus-env ~/goai_console.env
# 或在 shell 里 export 后运行 GOAI_CORPUS=private bash scripts/reproduce_core.sh。
# 三个变量成对配置；公开精简包（submission/02_研究数据与证据包/corpus_release）不需要后两个。
GOAI_LOCAL_CORPUS_ROOTS=/path/to/markdown-v1-final
GOAI_LOCAL_CORPUS_EXPECTED_INDEX=/path/to/markdown_expected.sqlite
GOAI_LOCAL_CORPUS_SHARD_ROOT=/path/to/markdown-v1/shards
